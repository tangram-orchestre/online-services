# Start development environment
dev: ensure-certs build-env
    docker compose up --remove-orphans

# Start development environment with a real Authentik instead of fake-auth
# (https://auth.localhost, see dev/authentik/README.md)
dev-authentik: ensure-certs build-env
    docker compose -f docker-compose.yaml -f dev/authentik/docker-compose.yaml up --remove-orphans

# Build development environment
build-env:
    #!/usr/bin/env bash
    echo UID=$(id -u) > .env
    echo GID=$(id -g) >> .env

    docker compose build

diesel *diesel_cmd:
    docker compose run --rm backend diesel {{ diesel_cmd }}

# Regenerate the database schema documentation served at https://schema.localhost
# (`just dev` already does it whenever the schema changes)
db-schema:
    docker compose run --rm --build schemaspy --once

# Screenshot dev stack pages into dev/screenshots (`just screenshot --help`)
[positional-arguments]
screenshot *args:
    mkdir -p dev/screenshots
    docker compose run --rm screenshot "$@"

### Backend

[group('lint')]
lint-backend: build-env
    docker compose run --rm backend cargo fmt -- --check
    docker compose run --rm backend cargo clippy -- -D warnings

[group('lint-fix')]
lint-fix-backend: build-env
    docker compose run --rm backend cargo fmt
    docker compose run --rm backend cargo clippy --fix --allow-no-vcs

### Showcase Website

[group('lint')]
lint-showcase-website: build-env
    docker compose run --rm showcase-website yarn lint

[group('lint-fix')]
lint-fix-showcase-website: build-env
    docker compose run --rm showcase-website yarn lint:fix

### Portal

portal *cmd:
    docker compose run --rm portal {{ cmd }}

[group('lint')]
lint-portal: build-env
    docker compose run --rm portal yarn lint

[group('lint-fix')]
lint-fix-portal: build-env
    docker compose run --rm portal yarn lint:fix

### Global

[group('lint')]
lint: lint-backend lint-showcase-website lint-portal

[group('lint-fix')]
lint-fix: lint-fix-backend lint-fix-showcase-website lint-fix-portal

### Local dev certificates

# Generate local dev certificates using mkcert
[group('certs')]
generate-certs:
    #!/usr/bin/env bash
    if ! command -v mkcert &> /dev/null
    then
        echo "mkcert could not be found, please install it."
        exit 1
    fi

    mkcert -install

    mkcert \
        -cert-file ./dev/traefik/certs/localhost.pem \
        -key-file ./dev/traefik/certs/localhost-key.pem \
        localhost api.localhost portal.localhost traefik.localhost maildev.localhost pgweb.localhost schema.localhost auth.localhost

# Ensure local dev certificates exist
[group('certs')]
ensure-certs:
    #!/usr/bin/env bash
    set -e
    # Ensure certificates exist
    CERT_FILE="./dev/traefik/certs/localhost.pem"
    # Also regenerated when a domain was added since (auth.localhost)
    if [ ! -f "$CERT_FILE" ] || ! openssl x509 -in "$CERT_FILE" -noout -ext subjectAltName | grep -q auth.localhost; then
        just generate-certs
    fi
