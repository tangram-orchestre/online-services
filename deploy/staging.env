# Non-secret staging configuration, loaded by scripts/deploy.sh.
# Secrets live in the `.env` files next to each compose file (see sample.env).
APP_ENV=staging
DOMAIN=staging.tangram-orchestre.fr
DOZZLE_GROUP=Staging

# Staging is private: every route goes through Authentik
WEBSITE_HOSTS_RULE='Host(`www.staging.tangram-orchestre.fr`)'
WEBSITE_MIDDLEWARES=authentik@file
BACKEND_PUBLIC_MIDDLEWARES=authentik@file,strip-api@file

# Mails are caught by MailDev
SMTP_HOST=maildev
BACKEND_DB_DIR=/opt/docker-volumes/backend-staging-db
BACKEND_DB_BACKUP_DIR=/opt/db-backups/backend-postgres-staging
# Idempotent dev seeds, so a reset staging database is not empty
BACKEND_SEED_FILE=/opt/backend/seeds/dev.sql

# Databases snapshotted before each deploy and restored if it fails
DEPLOY_DATABASES="backend-postgres"
# Services stopped during the deploy (the maintenance page is shown meanwhile)
DEPLOY_STOPPED_SERVICES="showcase-website portal backend"
