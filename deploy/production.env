# Non-secret production configuration, loaded by scripts/deploy.sh.
# Secrets live in the `.env` files next to each compose file (see sample.env).
APP_ENV=production
DOMAIN=tangram-orchestre.fr
DOZZLE_GROUP=Apps

WEBSITE_HOSTS_RULE='Host(`tangram-orchestre.fr`) || Host(`www.tangram-orchestre.fr`)'
WEBSITE_MIDDLEWARES=redirect-to-www-production@docker
BACKEND_PUBLIC_MIDDLEWARES=strip-api@file

SMTP_HOST=smtp-relay.gmail.com
BACKEND_DB_DIR=/opt/docker-volumes/backend-db
BACKEND_DB_BACKUP_DIR=/opt/db-backups/backend-postgres
BACKEND_SEED_FILE=

# Databases snapshotted before each deploy and restored if it fails
DEPLOY_DATABASES="backend-postgres authentik-postgresql"
# Services stopped during the deploy (the maintenance page is shown meanwhile)
DEPLOY_STOPPED_SERVICES="showcase-website portal backend"
